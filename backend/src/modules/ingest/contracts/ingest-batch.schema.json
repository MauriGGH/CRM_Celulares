{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MauriGGH/CRM_Celulares/docs/contracts/ingest-batch.schema.json",
  "title": "Lote de ingesta del scraper",
  "description": "Contrato v1.0 entre el equipo de scrap (productor) y el backend (consumidor). Cualquier cambio sube schema_version y requiere aprobación de ambos equipos.",
  "type": "object",
  "required": ["schema_version", "source", "scraped_at", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9_]{3,50}$",
      "description": "Identificador estable del sitio fuente, ej. tienda_competidor_a"
    },
    "scraped_at": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "decimal": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "record": {
      "type": "object",
      "required": ["external_id", "source_url", "brand", "model", "price", "currency", "in_stock", "condition"],
      "additionalProperties": false,
      "properties": {
        "external_id": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Id del producto en el sitio fuente" },
        "source_url": { "type": "string", "format": "uri" },
        "brand": { "type": "string", "minLength": 1, "maxLength": 50, "description": "Normalizada: Samsung, Apple, Xiaomi, Motorola…" },
        "model": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Normalizado sin marca ni capacidad: Galaxy S25, iPhone 16 Pro" },
        "storage_gb": { "type": ["integer", "null"], "minimum": 1 },
        "ram_gb": { "type": ["integer", "null"], "minimum": 1 },
        "color": { "type": ["string", "null"], "maxLength": 50 },
        "condition": { "enum": ["nuevo", "reacondicionado", "usado"] },
        "price": { "$ref": "#/$defs/decimal" },
        "currency": { "const": "MXN", "description": "El scraper convierte a MXN antes de enviar" },
        "in_stock": { "type": "boolean" },
        "gtin": { "type": ["string", "null"], "pattern": "^[0-9]{8,14}$" },
        "specs": {
          "type": "object",
          "description": "Ficha técnica normalizada. Claves en snake_case con unidad en el nombre.",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "images": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
