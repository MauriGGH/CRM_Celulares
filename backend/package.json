{
  "name": "crm-celulares-backend",
  "version": "0.1.0",
  "description": "API REST del punto de venta online de celulares",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
