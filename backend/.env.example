# Para correr la API desde el host (npm run dev) contra el mongo/redis de
# docker compose (mongo y redis). Dentro de Docker estas variables vienen del .env de la raíz.
# directConnection=true porque desde el host el nombre "mongo" del replica set no resuelve.
MONGO_URI=mongodb://pos_api:cambia_esto_api@localhost:27017/pos?authSource=pos&directConnection=true

REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga
JWT_REFRESH_SECRET=cambia_esto_por_otra_clave_larga
JWT_EXPIRES_IN=8h

# Servidor
PORT=3001
NODE_ENV=development

# CORS — origen del frontend
CORS_ORIGIN=http://localhost:5173

# Ingesta del scraper
INGEST_API_KEY=cambia_esto_clave_ingesta

# Opcionales
SENTRY_DSN=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
