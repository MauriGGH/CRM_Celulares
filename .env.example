# Copiar a .env en la raíz y ajustar. Docker Compose lo lee automáticamente.

# --- General ---
NODE_ENV=development
DOMAIN=localhost

# --- MongoDB (contenedor "mongo", replica set rs0) ---
# Local: sin autenticación, solo desarrollo.
MONGO_URI=mongodb://mongo:27017/crm_celulares?replicaSet=rs0
# Desde tu máquina, fuera de Docker: mongodb://localhost:27017/crm_celulares?directConnection=true
#
# Staging/producción (VPS, con infra/docker-compose.prod.yml): auth + keyFile.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=cambia_esto
MONGO_APP_USER=crm_api
MONGO_APP_PASSWORD=cambia_esto_tambien
# En producción: MONGO_URI=mongodb://crm_api:<MONGO_APP_PASSWORD>@mongo:27017/crm_celulares?replicaSet=rs0&authSource=crm_celulares

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Backend ---
PORT=3001
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=cambia_esto_por_una_clave_larga
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=otra_clave_larga
# Días de vigencia del refresh token (cookie httpOnly) y del access token de clientes
REFRESH_TOKEN_DAYS=30
JWT_CLIENT_EXPIRES_IN=15m
# URL pública de la tienda (enlaces en correos y regreso de pagos) y de la API (webhooks)
PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001
# Host de la API para sistemas externos (/external/v1); enlaces firmados de exportación
EXTERNAL_PUBLIC_URL=http://localhost:3001
# Proxies de confianza para req.ip (número de saltos o lista de redes). La IP real llega en CF-Connecting-IP.
TRUST_PROXY=loopback, linklocal, uniquelocal
# Minutos que el checkout aparta el stock mientras el cliente paga
RESERVA_MINUTOS=15
# Token que usa el servicio de scraping (otro equipo) para POST /internal/v1/ingest/batches
# (el backend acepta INGEST_API_KEY o INGEST_SERVICE_TOKEN)
INGEST_SERVICE_TOKEN=token_largo_compartido_con_scraper
# Similitud mínima (0-1) para que un registro sin empate exacto quede como `conflicto`
INGEST_REVIEW_SIMILARITY=0.6
# Correo transaccional (vacío = solo se registra en el log)
SMTP_URL=
MAIL_FROM="CRM Celulares <no-responder@example.com>"

# --- Pagos ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Webhook de PayPal (Developer → Webhooks) para verificar la firma
PAYPAL_WEBHOOK_ID=
MP_ACCESS_TOKEN=
# Clave secreta del webhook de Mercado Pago (Tus integraciones → Webhooks)
MP_WEBHOOK_SECRET=

# --- Almacenamiento S3 compatible (imágenes y respaldos) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# URL pública del bucket para las imágenes; sin S3_BUCKET se guardan en MEDIA_DIR (/media)
S3_PUBLIC_URL=


# --- Despliegue en la Raspberry Pi (solo staging/producción) ---
# production | staging (nombre en respaldos y Sentry)
DEPLOY_ENV=production
# en staging: crm-staging
COMPOSE_PROJECT_NAME=crm-celulares
# p. ej. monitoring (activa Uptime Kuma)
COMPOSE_PROFILES=
# local = imagen construida en la Pi (pi-deploy.sh); deploy.sh la reescribe con el tag de GHCR
IMAGE_TAG=local
# token del túnel en Cloudflare Zero Trust → Networks → Tunnels
TUNNEL_TOKEN=
# p. ej. ingest.<dominio> (único host que acepta /internal/v1/ingest)
INGEST_HOST=
# p. ej. api.<dominio> (único host que solo expone /external/*, la API de exportación)
EXTERNAL_HOST=
# Raspberry Pi 4 (no corre MongoDB 5+). Úsala también en local para no depender de funciones de 5.0+
MONGO_IMAGE=mongo:4.4.18
# en staging: crm_celulares_staging (ajustar también MONGO_URI)
MONGO_DB_NAME=crm_celulares
# 0.5 con 4 GB de RAM; 1 con 8 GB
MONGO_CACHE_GB=0.5
# 2g con 8 GB
MONGO_MEM_LIMIT=1500m
API_MEM_LIMIT=512m
WORKER_MEM_LIMIT=512m
# loopback de la Pi; en staging 27018
MONGO_LOCAL_PORT=27017
# loopback de la Pi para probar Caddy; en staging 8081
HTTP_LOCAL_PORT=8080

# --- Monitoreo ---
SENTRY_DSN=
# monitor "Push" (Uptime Kuma o UptimeRobot) para infra/scripts/health-check.sh
HEALTH_PUSH_URL=
DISK_ALERT_PERCENT=80
TEMP_ALERT_C=75
MEM_ALERT_PERCENT=90

# --- Respaldos (infra/scripts/backup.sh): SSD local + copia en Cloudflare R2 si hay S3_* ---
# si se deja vacío usa S3_BUCKET
BACKUP_BUCKET=
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_RETENTION_DAYS=14
