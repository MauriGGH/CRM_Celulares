# Variables para docker compose (local) y para /opt/pos/.env en el servidor.
# Copiar a .env y cambiar TODOS los valores "cambia_esto". Nunca subir .env al repo.

# --- Despliegue (solo servidor) ---
DEPLOY_ENV=development            # development | staging | production
SITE_ADDRESS=localhost            # dominio público, p. ej. tienda.ejemplo.mx
ACME_EMAIL=admin@example.com      # correo para Let's Encrypt
IMAGE_PREFIX=ghcr.io/mauriggh/pos-celulares
IMAGE_TAG=latest                  # lo reescribe el workflow de deploy

# --- MongoDB 7 (replica set de un nodo "rs0") ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=cambia_esto_superusuario
# Clave interna del replica set: openssl rand -base64 756 | tr -d '\n'
MONGO_REPLICA_KEY=cambia_esto_por_una_clave_base64_larga
APP_DB_NAME=pos
APP_DB_USER=pos_api
APP_DB_PASSWORD=cambia_esto_api
SCRAPER_DB_NAME=scraping
SCRAPER_DB_USER=pos_scraper
SCRAPER_DB_PASSWORD=cambia_esto_scraper

# --- API ---
NODE_ENV=development
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_REFRESH_SECRET=cambia_esto_por_otra_clave_larga_y_aleatoria
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Clave compartida API <-> scraper para /internal/v1/ingest/batches
INGEST_API_KEY=cambia_esto_clave_ingesta

# --- Pagos ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Almacenamiento S3 compatible (Cloudflare R2 o DigitalOcean Spaces) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Monitoreo ---
SENTRY_DSN=
SCRAPER_SENTRY_DSN=

# --- Respaldos (infra/scripts/backup.sh) ---
BACKUP_BUCKET=                    # bucket de respaldos, p. ej. pos-backups
BACKUP_RETENTION_DAYS=14
