# Copiar a .env en la raíz y ajustar. Docker Compose lo lee automáticamente.

# --- General ---
NODE_ENV=development
DOMAIN=localhost

# --- MongoDB (contenedor "mongo", replica set rs0) ---
# Local: sin autenticación, solo desarrollo.
MONGO_URI=mongodb://mongo:27017/crm_celulares?replicaSet=rs0
# Desde tu máquina, fuera de Docker: mongodb://localhost:27017/crm_celulares?directConnection=true
#
# Staging/producción (VPS, con infra/docker-compose.prod.yml): auth + keyFile.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=cambia_esto
MONGO_APP_USER=crm_api
MONGO_APP_PASSWORD=cambia_esto_tambien
# En producción: MONGO_URI=mongodb://crm_api:<MONGO_APP_PASSWORD>@mongo:27017/crm_celulares?replicaSet=rs0&authSource=crm_celulares

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Backend ---
PORT=3001
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=cambia_esto_por_una_clave_larga
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=otra_clave_larga
# Token que usa el servicio de scraping (otro equipo) para POST /internal/v1/ingest/batches
INGEST_SERVICE_TOKEN=token_largo_compartido_con_scraper

# --- Pagos ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
MERCADOPAGO_ACCESS_TOKEN=

# --- Almacenamiento S3 compatible (imágenes y respaldos) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=


# --- Despliegue en la Raspberry Pi (solo staging/producción) ---
DEPLOY_ENV=production               # production | staging (nombre en respaldos y Sentry)
COMPOSE_PROJECT_NAME=crm-celulares  # en staging: crm-staging
COMPOSE_PROFILES=                   # p. ej. monitoring (activa Uptime Kuma)
IMAGE_TAG=latest                    # lo reescribe deploy.sh
TUNNEL_TOKEN=                       # token del túnel en Cloudflare Zero Trust → Networks → Tunnels
INGEST_HOST=                        # p. ej. ingest.<dominio> (único host que acepta /internal/v1/ingest)
MONGO_IMAGE=mongo:4.4.18            # Raspberry Pi 4 (no corre MongoDB 5+). Úsala también en local para no depender de funciones de 5.0+
MONGO_DB_NAME=crm_celulares         # en staging: crm_celulares_staging (ajustar también MONGO_URI)
MONGO_CACHE_GB=0.5                  # 0.5 con 4 GB de RAM; 1 con 8 GB
MONGO_MEM_LIMIT=1500m               # 2g con 8 GB
API_MEM_LIMIT=512m
WORKER_MEM_LIMIT=512m
MONGO_LOCAL_PORT=27017              # loopback de la Pi; en staging 27018
HTTP_LOCAL_PORT=8080                # loopback de la Pi para probar Caddy; en staging 8081

# --- Monitoreo ---
SENTRY_DSN=
HEALTH_PUSH_URL=                    # monitor "Push" (Uptime Kuma o UptimeRobot) para infra/scripts/health-check.sh
DISK_ALERT_PERCENT=80
TEMP_ALERT_C=75
MEM_ALERT_PERCENT=90

# --- Respaldos (infra/scripts/backup.sh): SSD local + copia en Cloudflare R2 si hay S3_* ---
BACKUP_BUCKET=                      # si se deja vacío usa S3_BUCKET
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_RETENTION_DAYS=14
