# Copiar a .env en la raíz y ajustar. Docker Compose lo lee automáticamente.

# --- General ---
NODE_ENV=development
DOMAIN=localhost

# --- MongoDB (contenedor "mongo", replica set rs0) ---
# Local: sin autenticación, solo desarrollo.
MONGO_URI=mongodb://mongo:27017/crm_celulares?replicaSet=rs0
# Desde tu máquina, fuera de Docker: mongodb://localhost:27017/crm_celulares?directConnection=true
#
# Staging/producción (VPS, con infra/docker-compose.prod.yml): auth + keyFile.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=cambia_esto
MONGO_APP_USER=crm_api
MONGO_APP_PASSWORD=cambia_esto_tambien
# En producción: MONGO_URI=mongodb://crm_api:<MONGO_APP_PASSWORD>@mongo:27017/crm_celulares?replicaSet=rs0&authSource=crm_celulares

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Backend ---
PORT=3001
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=cambia_esto_por_una_clave_larga
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=otra_clave_larga
# Token que usa el servicio de scraping (otro equipo) para POST /internal/v1/ingest/batches
INGEST_SERVICE_TOKEN=token_largo_compartido_con_scraper

# --- Pagos ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
MERCADOPAGO_ACCESS_TOKEN=

# --- Almacenamiento S3 compatible (imágenes y respaldos) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

