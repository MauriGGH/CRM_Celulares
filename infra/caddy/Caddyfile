# DOMAIN=localhost en local (certificado interno); en el VPS, el dominio real
# (Caddy obtiene el certificado HTTPS automáticamente).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# La API interna (ingesta del scraping) nunca se expone a Internet.
	@internal path /internal/*
	respond @internal 403

	handle /api/* {
		reverse_proxy api:3001
	}

	# Frontend compilado (lo entrega el equipo de frontend en frontend/dist)
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
